#   GEN_API_KEY=sk-xxxx（DeepSeek key）
GEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEN_MODEL=qwen3-32b
GEN_API_KEY=

# ===== 政策检索（dknowc 可信搜索）=====
# 未配置 DKNOWC_API_KEY 时自动进入演示检索模式（界面带“演示数据”标识）
DKNOWC_API_KEY=
# RETRIEVAL_MOCK=1   # 强制演示检索

# ===== 其他 =====
# BB_JWT_SECRET=自定义会话密钥（缺省自动生成并持久化到 data/jwt.secret）
# BB_DATA_DIR=数据目录（缺省 backend/data）
